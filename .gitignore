# --- Secrets and local configuration (never versioned) ---
.env
.env.*
.secrets
*.local
*.param.env
*.pem
*.key
*.pfx
*.keystore
*.jks

# --- Python virtual environments ---
.venv/
.venv-win/
venv/
env/
ENV/

# --- Python caches and packaging ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Build outputs (reproducible with `python build.py`) ---
build/
dist/
dist_*/
releases/
*.exe
*.zip

# --- Logs, telemetry and mission data ---
*.log
*.tlog
*.rlog
telemetry_data/
*.waypoints

# --- Local backups ---
*.bak
*.backup
*.backup.*
*.before-*
*.video-backup

# --- Editors and operating system ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

